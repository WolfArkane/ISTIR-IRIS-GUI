<!DOCTYPE html>
<html lang="fr">

<head>
  <meta charset="UTF-8">
  <title>ISTIC-IRIS GUI</title>
  <link rel="stylesheet" href="./css/style.css">
  <link rel="stylesheet" href="./vendor/xterm.css">
  <script src="./vendor/xterm.js"></script>
  <script src="./vendor/xterm-addon-fit.js"></script>
</head>

<body>
  <div class="app">
    <aside class="sidebar">
      <div class="app-header">
        <img src="./assets/logo-icon.svg" alt="Logo" class="app-logo">
        <span class="app-title">ISTIR-IRIS</span>
      </div>

      <button id="theme-toggle" class="theme-toggle">🌙 Mode sombre</button>

      <div class="vpn-frame">
        <span class="vpn-label">VPN</span>
        <span id="vpn-status" class="vpn-status vpn-status--off">Déconnecté</span>
      </div>

      <div class="select-group">
        <label for="salle-select">Salle</label>
        <select id="salle-select">
          <option value="">-- Choisir une salle --</option>
        </select>
      </div>

      <div class="select-group">
        <label for="poste-select">Poste</label>
        <select id="poste-select" disabled>
          <option value="">-- Choisir un poste --</option>
        </select>
      </div>

      <div class="select-group">
        <label for="ssh-username">Utilisateur</label>
        <input type="text" id="ssh-username" placeholder="login">
      </div>

      <button id="connect-button" class="connect-button" disabled>Se connecter</button>
    </aside>

    <main class="content">
      <div id="terminal-container" class="terminal-container"></div>
    </main>
  </div>

  <script src="./js/theme.js"></script>
  <script src="./js/salles.js"></script>
  <script src="./js/terminal.js"></script>
  <script src="./js/vpn.js"></script>
  <script src="./vendor/alertbox.min.js"></script>
</body>
</html>