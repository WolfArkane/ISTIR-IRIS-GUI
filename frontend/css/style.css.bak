* {
  box-sizing: border-box;
}

:root {
  --bg-main: #1e1e1e;
  --bg-sidebar: #252526;
  --bg-panel: #2d2d2d;
  --border: #3a3a3a;
  --text: #e0e0e0;
  --text-muted: #999;
  --accent: #0e639c;
}

body.light-theme {
  --bg-main: #f5f5f5;
  --bg-sidebar: #ffffff;
  --bg-panel: #f0f0f0;
  --border: #ddd;
  --text: #1e1e1e;
  --text-muted: #666;
  --accent: #0e639c;
}

body {
  background: var(--bg-main);
  color: var(--text);
  margin: 0;
  font-family: "Segoe UI", sans-serif;
  height: 100vh;
  overflow: hidden;
}

.app {
  display: flex;
  height: 100vh;
}

.app-header {
  display: flex;
  align-items: center;
  gap: 10px;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--border);
}

.app-logo {
  width: 32px;
  height: 32px;
  object-fit: contain;
}

.app-title {
  font-size: 16px;
  font-weight: 600;
  color: var(--text);
}

.sidebar {
  width: 260px;
  background: var(--bg-sidebar);
  border-right: 1px solid var(--border);
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 20px;
  overflow-y: auto;
  min-height: 0;
}

.theme-toggle {
  padding: 8px 10px;
  border: 1px solid var(--border);
  border-radius: 6px;
  background: var(--bg-panel);
  color: var(--text);
  cursor: pointer;
  font-size: 13px;
}

.vpn-frame {
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  background: var(--bg-panel);
}

.vpn-label {
  font-size: 12px;
  text-transform: uppercase;
  color: var(--text-muted);
  letter-spacing: 0.5px;
}

.vpn-status {
  font-weight: 600;
  font-size: 14px;
}

.vpn-status--off {
  color: #e06c75;
}

.vpn-status--on {
  color: #98c379;
}

.vpn-button {
  padding: 6px 10px;
  border: none;
  border-radius: 6px;
  background: var(--border);
  color: var(--text-muted);
  cursor: not-allowed;
  font-size: 13px;
}

.select-group {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.select-group label {
  font-size: 12px;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

.select-group select {
  padding: 8px;
  border-radius: 6px;
  border: 1px solid var(--border);
  background: var(--bg-panel);
  color: var(--text);
  font-size: 14px;
}

.select-group input {
  padding: 8px;
  border-radius: 6px;
  border: 1px solid var(--border);
  background: var(--bg-panel);
  color: var(--text);
  font-size: 14px;
}

.select-group select:disabled {
  opacity: 0.5;
}

.connect-frame {
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  background: var(--bg-panel);
}

.connect-button {
  margin-top: auto;
  padding: 10px;
  border: none;
  border-radius: 6px;
  background: var(--accent);
  color: white;
  font-weight: 600;
  cursor: not-allowed;
  opacity: 0.5;
}

.connect-button.active {
  cursor: pointer;
  opacity: 1;
}

.content {
  flex: 1;
  min-width: 0;
  padding: 16px;
  display: flex;
}

.terminal-placeholder {
  flex: 1;
  background: #0c0c0c;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #555;
  font-family: monospace;
}

.terminal-container {
  flex: 1;
  min-width: 0;
  background: #0c0c0c;
  border-radius: 8px;
  padding: 8px;
}

.terminal-container .xterm {
  height: 100% !important;
  width: 100% !important;
}

.terminal-container .xterm-viewport {
  width: 100% !important;
}